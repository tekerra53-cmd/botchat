{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "templates/**,static/**,app.py,config.py,models.py,utils.py,wsgi.py",
      "excludeFiles": "{.git,.github,.venv,venv,__pycache__,instance,*.pyc}"
    }
  }
}
